# Copy to .env.local for local overrides. Never commit real values.

# --- Database ---------------------------------------------------------------
# Leave unset to run on the built-in database (PGlite) with fake demo data.
#   npm run dev (locally)  -> saved in .data/pglite between restarts
#   on Vercel / DEMO_MODE  -> in memory, resets when the server restarts
# Set to the Supabase Postgres connection string once the pilot is approved.
DATABASE_URL=

# Force the in-memory demo database even locally (used by the e2e tests).
DEMO_MODE=

# --- Sessions ---------------------------------------------------------------
# Secret used to sign session cookies. Required when DATABASE_URL is set.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Sign-in codes: leave all of these unset to show codes on screen (demo only).
# See README "Real sign-in codes for the demo". Email sign-in uses Resend. Phone sign-in uses
# Twilio when it's set, otherwise Resend.

# --- Sign-in codes by email (Resend, free) ---------------------------------
# Demo only: every code goes to DEMO_EMAIL_TO, whatever email or number is typed
# (what was typed still decides who signs in). Not allowed with DATABASE_URL.
RESEND_API_KEY=
DEMO_EMAIL_TO=
# Optional. Needs a domain verified in Resend. Default: SCCSC Staff <onboarding@resend.dev>
EMAIL_FROM=

# --- Sign-in text messages (Twilio Verify, optional, costs money) ----------
# Set all three to send real texts. See README "Real sign-in texts for the demo".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Demo only: send every sign-in code to this phone, whatever number is typed
# (the typed number still decides who signs in). Not allowed with DATABASE_URL.
# Example: +19165551234
DEMO_SMS_TO=
